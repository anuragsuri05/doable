# Optional platform keys. Users can always bring their own key in Settings → AI providers;
# when a user has no key for a provider, these are used instead. Set DOABLE_PLATFORM_KEYS=off to disable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Encrypts stored API keys and project secrets. Required in production (any long random string).
DOABLE_SECRET=

# Where the database, project workspaces and published sites live (default ./.data)
# DOABLE_DATA_DIR=

# Host that published apps are served under as <slug>.<host> (default: the request host, e.g. localhost:3000)
# DOABLE_SITES_HOST=doable.app
